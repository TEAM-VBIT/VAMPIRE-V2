# Get these values from my.telegram.org/apps
API_ID=
API_HASH=

# Get these from @BotFather on Telegram
BOT_TOKEN=
# Your log group ID, add your bot there and promote as an admin.
LOGGER_ID=

# MongoDB URL from cloud.mongodb.com
MONGO_URL=

# The user ID of the user whom you would like to add as OWNER.
OWNER_ID=

# Pyrogram v2 String Session from @StringFatherBot on Telegram.
SESSION=
SESSION2=
SESSION3=

# Optional: Limits for playback
DURATION_LIMIT=60
QUEUE_LIMIT=20
PLAYLIST_LIMIT=20

# Optional: Support group and channel
SUPPORT_CHANNEL=https://t.me/VAMPIREUPDATES
SUPPORT_CHAT=https://t.me/VAMPIREUPDATES

# Optional: Feature toggles
AUTO_END=False
AUTO_LEAVE=False
VIDEO_PLAY=True

# Optional: Custom images
DEFAULT_THUMB=https://te.legra.ph/file/3e40a408286d4eda24191.jpg
PING_IMG=https://i.ibb.co/fzQJvwB9/x.jpg
START_IMG=https://i.ibb.co/fzQJvwB9/x.jpg

# Optional: Cookies for YouTube (space-separated batbin.me URLs)
COOKIES_URL=
